{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=EmployeeHRMS_Db;Username=postgres;Password=REPLACE_WITH_YOUR_POSTGRES_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "AppSettings": {
    "ApiName": "Employee HRMS API",
    "ApiVersion": "v1",
    "MaxPageSize": 50,
    "DefaultPageSize": 10
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "EmployeeHRMS.Api",
    "Audience": "EmployeeHRMS.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "MaxActiveSessionsPerUser": 5
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "HRMS System",
    "SenderEmail": "noreply@hrms.com",
    "SmtpUsername": "",
    "SmtpPassword": "",
    "EnableSsl": true
  },
  "FrontendBaseUrl": "http://localhost:5173",
  "OpenAiSettings": {
    "ApiKey": "REPLACE_WITH_YOUR_OPENAI_API_KEY",
    "Model": "gpt-4o-mini",
    "JdTemperature": 0.4,
    "QuestionTemperature": 0.5,
    "MaxRetries": 2
  },
  "AudioInterview": {
    "DefaultThinkSeconds": 20,
    "DefaultAnswerSeconds": 90,
    "DefaultInviteExpiryDays": 3,
    "BaseCandidatePortalUrl": "http://localhost:5173/interview"
  },
  "SpeechMetrics": {
    "WpmThresholdHigh": 210.0,
    "WpmThresholdLow": 90.0,
    "PauseVariationCvThreshold": 0.18,
    "TrimSilenceHeadTailSeconds": 1.0,
    "MaxNoSpeechProbability": 0.8
  },
  "Scoring": {
    "ModelName": "gpt-4o-mini",
    "PromptVersion": "v1.0",
    "Temperature": 0.2,
    "MaxTokens": 1200,
    "MaxHttpRetries": 3,
    "MaxSemanticRetries": 2,
    "PoorScore": 2.5,
    "AcceptableScore": 5.0,
    "GoodScore": 7.5,
    "ExcellentScore": 10.0,
    "PassThreshold": 7.0,
    "ConsiderThreshold": 5.0,
    "TechnicalKnockoutMinScore": 5.0
  }
}